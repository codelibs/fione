# Copy to docker/.env (never commit it) and fill in the S3 values; compose refuses to start
# while one is missing. Generate each secret with:
#   openssl rand -hex 32
# The S3 values may only use A-Z a-z 0-9 / + = . _ - (SeaweedFS refuses to start otherwise).

# The S3 identity Fione and SeaweedFS share: an access key (openssl rand -hex 16)...
FIONE_S3_ACCESS_KEY=

# ...and its secret (openssl rand -hex 32).
FIONE_S3_SECRET_KEY=

# Optional: a fixed first-admin setup token (16+ characters). Left empty, Fione generates
# one and logs it at every start until an administrator exists:
#   docker compose -f docker/compose.yaml logs fione | grep "Setup token"
FIONE_SETUP_TOKEN=

# Optional: the image tag (the release version), the same for every Fione image.
# FIONE_IMAGE_TAG=dev
# Optional: the host port (bound to 127.0.0.1).
# FIONE_PORT=8080

# Notebooks (the Compose profile `notebook`), off while FIONE_NOTEBOOK_URL is empty. Both
# URLs as browsers reach them, scheme://host[:port], with the same host name: localhost and
# 127.0.0.1 are different sites, and the notebook frame then cannot sign in.
# FIONE_PUBLIC_URL=http://127.0.0.1:8080
# FIONE_NOTEBOOK_URL=http://127.0.0.1:8888
# The secret Fione and the notebook launcher share (openssl rand -hex 32).
# FIONE_NOTEBOOK_LAUNCHER_SECRET=
# Optional: the notebook gateway's host port (bound to 127.0.0.1).
# FIONE_NOTEBOOK_PORT=8888
# Optional: how long a notebook runs at most, in seconds (600 to 604800).
# FIONE_NOTEBOOK_MAX_LIFETIME_SECS=43200
# Optional: how many notebooks run at once at most, for all users (each may use 2 CPUs, 4 GiB).
# FIONE_NOTEBOOK_MAX_RUNNING=4
