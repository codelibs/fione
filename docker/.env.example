# Copy to docker/.env (never commit it) and fill in the S3 values; compose refuses to start
# while one is missing. Generate each secret with:
#   openssl rand -hex 32
# The S3 values may only use A-Z a-z 0-9 / + = . _ - (SeaweedFS refuses to start otherwise).

# The S3 identity Fione and SeaweedFS share: an access key (openssl rand -hex 16)...
FIONE_S3_ACCESS_KEY=

# ...and its secret (openssl rand -hex 32).
FIONE_S3_SECRET_KEY=

# Optional: a fixed first-admin setup token (16+ characters). Left empty, Fione generates
# one and logs it at every start until an administrator exists:
#   docker compose -f docker/compose.yaml logs fione | grep "Setup token"
FIONE_SETUP_TOKEN=

# Optional: the image tag (the release version), the same for every Fione image.
# FIONE_IMAGE_TAG=dev
# Optional: the host port (bound to 127.0.0.1).
# FIONE_PORT=8080

# Optional: Fione's own address as browsers reach it, scheme://host[:port]. The MCP endpoint
# accepts browser requests from this origin (see FIONE_MCP_ENABLED below).
# FIONE_PUBLIC_URL=http://127.0.0.1:8080

# Optional: let MCP clients such as Claude Code or Codex read your projects at /mcp with an API
# token. They need no language model in Fione.
# FIONE_MCP_ENABLED=true
# Optional: let those clients also create projects, add datasets and queue training,
# prediction and module jobs.
# FIONE_MCP_WRITE_ENABLED=true

# Optional: the assistant, a chat and comments in the browser. It is off unless a language
# model is set here; use one of the blocks below.
#
# The Ollama app on the host (macOS): install Ollama there, set OLLAMA_CONTEXT_LENGTH=16384
# for it, and download the model with the button on the system page
# (http://host.docker.internal:11434/v1, model gemma4:12b-mlx).
# FIONE_LLM_PROVIDER=ollama
#
# Linux, or no Ollama on the host: run Ollama in Compose (CPU only, about 8 GB to download).
# FIONE_LLM_PROVIDER=ollama
# COMPOSE_PROFILES=ollama
# FIONE_LLM_BASE_URL=http://ollama:11434/v1
# FIONE_LLM_MODEL=gemma4:12b
# FIONE_LLM_AUTO_PULL=true
#
# Claude through the Anthropic API: set the provider and the key (FIONE_LLM_BASE_URL and
# FIONE_LLM_MODEL default to the Anthropic API and a current Claude model).
# FIONE_LLM_PROVIDER=claude
# FIONE_LLM_API_KEY=
