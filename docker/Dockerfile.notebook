# Fione Notebook: the per-user JupyterLab of the opt-in Compose profile `notebook`, started by
# the notebook launcher and signed in through Fione (src/fione_notebook).
#
#   docker build -f docker/Dockerfile.notebook --build-arg FIONE_IMAGE_TAG=<version> \
#       -t ghcr.io/codelibs/fione-notebook:<version> .
#
# The launcher supplies FIONE_NB_OWNER, _KEY, _COOKIE_SECRET, _ORIGIN and _EXPIRES at start.
# Every user's JupyterLab shares one browser origin, so nothing Jupyter serves or loads may be
# writable by the user: the Jupyter config and data dirs and the virtualenv are root-owned and
# read-only, and the server refuses to start otherwise. Nothing is installed at start (the
# containers have no egress), so this image is the whole library set of a notebook.

FROM python:3.12.15-slim-trixie AS build

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_NO_CACHE=1

# The locked notebook group only (Jupyter, the kernel, pandas, plotting), then the SDK, whose
# dependencies are in that group.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --only-group notebook

COPY sdk/ sdk/
# uv leaves a world-writable lock file in the virtualenv.
RUN uv pip install --no-deps ./sdk && rm .venv/.lock

COPY src/fione_notebook/ src/fione_notebook/
RUN .venv/bin/python -m compileall -q src


FROM python:3.12.15-slim-trixie

ARG FIONE_IMAGE_TAG=dev
LABEL org.opencontainers.image.version=${FIONE_IMAGE_TAG}

# uid/gid 1000, as the launcher runs the container. The work dir is created here so that a new
# named volume mounted on it is owned by the user.
RUN groupadd --gid 1000 nb \
    && useradd --uid 1000 --gid 1000 --home-dir /home/nb --create-home --shell /bin/bash nb \
    && install -d -o nb -g nb /home/nb/work

# Root-owned and not writable by nb: the virtualenv, the extension, the Jupyter config and data
# dirs (empty, mode 0555), the server config and JupyterLab's page config.
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/src /app/src
# The parent dirs first: COPY --chmod would give the dirs it creates the files' mode.
RUN install -d -m 0555 /etc/jupyter-fione /usr/local/share/jupyter-fione \
    && install -d -m 0755 /etc/jupyter /app/.venv/etc/jupyter/labconfig
COPY --chmod=0444 docker/notebook/jupyter_server_config.py /etc/jupyter/jupyter_server_config.py
COPY --chmod=0444 docker/notebook/page_config.json /app/.venv/etc/jupyter/labconfig/page_config.json

# No JUPYTER_PATH or JUPYTER_CONFIG_PATH, and no Python user site: either would add
# user-writable dirs to what Jupyter serves and loads. The runtime dir (connection files) is
# writable and never served.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    PYTHONNOUSERSITE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/nb \
    SHELL=/bin/bash \
    JUPYTER_CONFIG_DIR=/etc/jupyter-fione \
    JUPYTER_DATA_DIR=/usr/local/share/jupyter-fione \
    JUPYTER_RUNTIME_DIR=/tmp/jupyter-runtime

USER 1000:1000
WORKDIR /home/nb/work
EXPOSE 8888

# Any HTTP status means the server is up: the login page refuses a request without a launch
# token (403). Only a connection error counts as down.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import os, urllib.error, urllib.request as u\ntry:\n    u.urlopen('http://127.0.0.1:8888/user/%s/login' % os.environ['FIONE_NB_OWNER'], timeout=3)\nexcept urllib.error.HTTPError:\n    pass"]

# The console script, never `python -m` (that would put the user-writable work dir on sys.path).
CMD ["jupyter", "lab", "--no-browser"]
